# Organizer-issued per-team salt. NEVER commit the real value. Pass it on the command line:
#   DAY1_SALT=<salt> docker compose up -d --build
DAY1_SALT=change-me
# Optional: JWT signing secret (defaults to a value derived from DAY1_SALT)
JWT_SECRET=
# Set automatically by docker-compose.yml for the api/worker services:
DATABASE_URL=postgres://nascon:nascon@db:5432/nascon
REDIS_URL=redis://redis:6379
PORT=8080
